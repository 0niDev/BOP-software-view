# SQLite Cloud configuration — copy to .env.local and fill in real values.
# NEVER commit .env.local or the real API key to git.
#
# The Weblite SQL endpoint looks like:
#   https://<project-id>.<zone>.sqlite.cloud/v2/weblite/sql
# For this project that is:
#   https://cjja8z6pvz.g4.sqlite.cloud/v2/weblite/sql
#
# The database name comes from the connection string:
#   sqlitecloud://.../main?apikey=...
# In this project the database is `main`.

VITE_SQLITECLOUD_URL=https://cjja8z6pvz.g4.sqlite.cloud/v2/weblite/sql
VITE_SQLITECLOUD_API_KEY=your-api-key-here
VITE_SQLITECLOUD_DATABASE=main

# Demo mode: set to 1 to run the UI on built-in sample data (no network, no
# credentials needed). Leave unset or 0 for the live database.
VITE_DEMO_MODE=0
